{
  "expo": {
    "name": "kitarchive",
    "slug": "kitarchive",
    "scheme": "kitarchive",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "appleTeamId": "7VJ997Q842",
      "bundleIdentifier": "com.matiasturra.kitarchive",
      "buildNumber": "2",
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.matiasturra.kitarchive"
        ],
        "com.apple.developer.usernotifications.time-sensitive": true
      },
      "infoPlist": {
        "NSUserNotificationUsageDescription": "This app uses notifications to remind you about the things you track.",
        "NSPhotoLibraryUsageDescription": "Attach photos of your shirts and kit reference images.",
        "NSPhotoLibraryAddUsageDescription": "Save shirt photos to your Photos library.",
        "NSCameraUsageDescription": "Photograph the shirts in your collection.",
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleLocalizations": [
          "en",
          "es"
        ]
      }
    },
    "android": {
      "package": "com.matiasturra.kitarchive",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0a234e"
      },
      "permissions": [
        "android.permission.NOTIFICATIONS",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#fcba03"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Attach photos of your shirts and kit reference images.",
          "cameraPermission": "Photograph the shirts in your collection."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0f172a",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#0f172a"
          }
        }
      ],
      [
        "expo-widgets",
        {
          "groupIdentifier": "group.com.matiasturra.kitarchive",
          "widgets": [
            {
              "name": "HomeWidget",
              "displayName": "KitArchive",
              "description": "Collection progress for one of your teams.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium",
                  "accessoryRectangular"
                ],
                "configuration": {
                  "title": "Team",
                  "description": "Pick the team to track.",
                  "parameters": {
                    "teamId": {
                      "title": "Team",
                      "type": "enum",
                      "default": "boca_juniors",
                      "values": [
                        {
                          "name": "Boca Juniors",
                          "value": "boca_juniors"
                        },
                        {
                          "name": "Argentina",
                          "value": "argentina"
                        },
                        {
                          "name": "Brazil",
                          "value": "brazil"
                        },
                        {
                          "name": "Uruguay",
                          "value": "uruguay"
                        },
                        {
                          "name": "England",
                          "value": "england"
                        },
                        {
                          "name": "France",
                          "value": "france"
                        },
                        {
                          "name": "Germany",
                          "value": "germany"
                        },
                        {
                          "name": "Italy",
                          "value": "italy"
                        },
                        {
                          "name": "Spain",
                          "value": "spain"
                        },
                        {
                          "name": "Netherlands",
                          "value": "netherlands"
                        },
                        {
                          "name": "Portugal",
                          "value": "portugal"
                        }
                      ]
                    }
                  }
                }
              }
            }
          ]
        }
      ],
      "expo-localization"
    ],
    "extra": {
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "ExpoWidgetsTarget",
                  "bundleIdentifier": "com.matiasturra.kitarchive.ExpoWidgetsTarget",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.com.matiasturra.kitarchive"
                    ]
                  }
                }
              ]
            }
          }
        },
        "projectId": "3ad9af1f-3af2-4ae9-97a3-3539a3176f6f"
      }
    }
  }
}
