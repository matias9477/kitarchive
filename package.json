{
  "name": "kitarchive",
  "version": "1.0.0",
  "main": "index.ts",
  "private": true,
  "scripts": {
    "start": "npx expo start",
    "ios": "npx expo run:ios",
    "android": "npx expo run:android",
    "web": "npx expo start --web",
    "rebuild:ios": "npx expo prebuild --platform ios --clean && npx expo run:ios",
    "commit": "git-cz",
    "commit:retry": "git-cz --retry",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "release": "expo-release",
    "db:generate": "drizzle-kit generate",
    "db:introspect": "drizzle-kit introspect"
  },
  "config": {
    "commitizen": {
      "path": "./commitizen.config.js"
    }
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/sora": "^0.4.2",
    "@expo/ui": "~57.0.11",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.18.16",
    "@react-navigation/native": "^7.3.16",
    "@react-navigation/native-stack": "^7.18.8",
    "@react-navigation/stack": "^7.10.22",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "expo": "~57.0.14",
    "expo-constants": "~57.0.12",
    "expo-file-system": "~57.0.4",
    "expo-font": "~57.0.1",
    "expo-image-picker": "~57.0.11",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.6",
    "expo-localization": "~57.0.1",
    "expo-notifications": "~57.0.12",
    "expo-splash-screen": "~57.0.7",
    "expo-sqlite": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "expo-widgets": "~57.0.10",
    "i18next": "^26.3.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-i18next": "^17.0.11",
    "react-native": "0.86.2",
    "react-native-confetti-cannon": "^1.5.2",
    "react-native-modal-datetime-picker": "^18.0.0",
    "react-native-purchases": "^10.7.1",
    "react-native-purchases-ui": "^10.7.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-webview": "13.16.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@babel/core": "^7.28.5",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@digitalroute/cz-conventional-changelog-for-jira": "^8.0.1",
    "@matias9477/expo-release": "github:matias9477/expo-release",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.4",
    "babel-plugin-module-resolver": "^5.0.2",
    "babel-preset-expo": "~57.0.0",
    "commitizen": "^4.3.2",
    "cz-conventional-changelog": "^3.3.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.8.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "jest": "~29.7.0",
    "jest-environment-jsdom": "~29.7.0",
    "jest-expo": "~57.0.4",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.6",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.67.0"
  }
}
